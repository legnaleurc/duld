# Environment variables for Docker Compose.

# Compose files to use, separated by `:`.
# `compose.yaml` is always required, plus exactly one upload backend
# (`compose.drive.yaml` or `compose.local.yaml`), plus one file per optional
# feature you enabled in the config:
#   compose.transmission.yaml - `transmission`
#   compose.hah.yaml          - `hah_path`
#   compose.exclude.yaml      - `exclude.dynamic`
# A COMPOSE_FILE set in the process environment (e.g. by a systemd
# EnvironmentFile) takes precedence over this one.
COMPOSE_FILE=compose.yaml:compose.drive.yaml

# Host to bind for the docker host.
DULD_HOST=127.0.0.1
# Port to bind for the docker host.
DULD_PORT=1234

# The config file for this daemon.
DULD_CONFIG_FILE=/path/to/duld.yaml

# --- drive backend (compose.drive.yaml) ---

# The config file for the `wcpan.drive.cli` module.
DULD_DRIVE_FILE=/path/to/drive.yaml
# The config dir for `wcpan.drive`.
DULD_DRIVE_CONFIG_PATH=/path/to/drive/config
# The data dir for `wcpan.drive`.
DULD_DRIVE_DATA_PATH=/path/to/drive/data

# --- local backend (compose.local.yaml) ---

# The upload dir for the local backend.
DULD_LOCAL_PATH=/path/to/local/upload

# --- transmission (compose.transmission.yaml) ---

# Transmission download dir, mounted read-only at /mnt/tm.
# Set `transmission.download_dir` to /mnt/tm in the config.
DULD_TM_PATH=/path/to/transmission/download

# --- hah (compose.hah.yaml) ---

# HaH root dir, mounted read-write at /mnt/hah.
# Set `hah_path` to /mnt/hah in the config.
DULD_HAH_PATH=/path/to/hah

# --- dynamic exclude (compose.exclude.yaml) ---

# Directory holding the dynamic exclude database, mounted at /mnt/db.
# Set `exclude.dynamic` to /mnt/db/duld.sqlite in the config.
DULD_DB_PATH=/path/to/duld/db
